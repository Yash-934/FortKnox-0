<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Outer Shield Halo / Border -->
    <path
        android:pathData="M54,22 L78,32 C78,58 66,74 54,84 C42,74 30,58 30,32 Z"
        android:strokeWidth="2.5"
        android:strokeColor="#00F0FF"
        android:fillColor="#151D2C" />
    
    <!-- Inner Shield Accent -->
    <path
        android:pathData="M54,28 L72,36 C72,55 62,68 54,76 C46,68 36,55 36,36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36"
                android:startY="28"
                android:endX="72"
                android:endY="76"
                android:type="linear">
                <item android:offset="0.0" android:color="#00E5FF" />
                <item android:offset="0.6" android:color="#0072FF" />
                <item android:offset="1.0" android:color="#7000FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Padlock Body -->
    <path
        android:pathData="M46,50 H62 V64 H46 Z"
        android:fillColor="#0A0E17"
        android:strokeWidth="1.2"
        android:strokeColor="#00F0FF" />

    <!-- Padlock Shackle -->
    <path
        android:pathData="M48,50 V45 C48,41.7 50.7,39 54,39 C57.3,39 60,41.7 60,45 V50"
        android:strokeWidth="2.2"
        android:strokeColor="#FFFFFF"
        android:fillColor="#00000000" />

    <!-- Glowing Keyhole Core -->
    <path
        android:pathData="M54,54 A2,2 0 1 0 54,58 L54,60"
        android:strokeWidth="1.8"
        android:strokeColor="#00F0FF"
        android:fillColor="#00F0FF" />
</vector>
