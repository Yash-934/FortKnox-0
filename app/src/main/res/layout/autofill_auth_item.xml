<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:gravity="center_vertical"
    android:background="#121820">

    <TextView
        android:id="@+id/autofill_auth_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="🔒"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginEnd="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/autofill_auth_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unlock Fort Knox to Autofill"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/autofill_auth_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap to enter PIN or biometric unlock"
            android:textColor="#8F9BA8"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
